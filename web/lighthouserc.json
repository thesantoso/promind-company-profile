{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/id/",
        "http://localhost/en/",
        "http://localhost/id/layanan/",
        "http://localhost/en/portfolio/",
        "http://localhost/id/karir/building-manager/",
        "http://localhost/en/about/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://[^/]+/(id|en)/$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1650,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 512000
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/(id|en)/.+",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 512000
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
