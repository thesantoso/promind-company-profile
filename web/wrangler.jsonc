// Deploy situs publik ke Cloudflare (Workers + static assets). Staging dan produksi punya Worker sendiri.
// Pasang domain: staging.promind.co.id sekarang; promind.co.id dan www saat cutover (tahap 4).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promind-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "ADMIN", "service": "promind-admin" }],
  "env": {
    "staging": {
      "name": "promind-web-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "staging.promind.co.id", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/api/*"]
      },
      "services": [{ "binding": "ADMIN", "service": "promind-admin" }]
    },
    "production": {
      "name": "promind-web",
      "workers_dev": false,
      "routes": [
        { "pattern": "promind.co.id", "custom_domain": true },
        { "pattern": "www.promind.co.id", "custom_domain": true }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/api/*"]
      },
      "services": [{ "binding": "ADMIN", "service": "promind-admin" }]
    }
  }
}
