---
import '../styles/global.css';
const site = Astro.site!.href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex, follow" />
    <title>PROMIND</title>
    <link rel="canonical" href={`${site}/id/`} />
    <link rel="alternate" hreflang="id-ID" href={`${site}/id/`} />
    <link rel="alternate" hreflang="en-US" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/id/`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/scripts/lang-redirect.js" defer></script>
  </head>
  <body>
    <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-6 px-4 text-center">
      <h1 class="m-0 text-4xl font-extrabold">PROMIND</h1>
      <p class="m-0">Pilih bahasa / Choose a language</p>
      <ul class="m-0 flex list-none flex-col gap-3 p-0 sm:flex-row sm:justify-center">
        <li><a class="inline-flex min-h-11 items-center border border-hairline-strong bg-surface px-6 font-display font-bold no-underline" href="/id/" hreflang="id-ID" lang="id-ID">Bahasa Indonesia</a></li>
        <li><a class="inline-flex min-h-11 items-center border border-hairline-strong bg-surface px-6 font-display font-bold no-underline" href="/en/" hreflang="en-US" lang="en-US">English</a></li>
      </ul>
    </main>
  </body>
</html>
