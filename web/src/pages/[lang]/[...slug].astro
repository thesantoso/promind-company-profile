---
import AboutPage from '../../components/pages/AboutPage.astro';
import InsightsPage from '../../components/pages/InsightsPage.astro';
import PlaceholderPage from '../../components/PlaceholderPage.astro';
import PortfolioPage from '../../components/pages/PortfolioPage.astro';
import ServicesPage from '../../components/pages/ServicesPage.astro';
import { LOCALES } from '../../i18n/locales';
import { ROUTES, type RouteKey } from '../../i18n/routes';

export function getStaticPaths() {
  const keys = (Object.keys(ROUTES) as RouteKey[]).filter((k) => k !== 'home');
  return keys.flatMap((routeKey) =>
    LOCALES.map((lang) => ({
      params: { lang, slug: ROUTES[routeKey][lang] },
      props: { lang, routeKey },
    })),
  );
}
const { lang, routeKey } = Astro.props;
---

{routeKey === 'services' ? <ServicesPage lang={lang} />
  : routeKey === 'portfolio' ? <PortfolioPage lang={lang} />
  : routeKey === 'research' ? <InsightsPage lang={lang} />
  : routeKey === 'about' ? <AboutPage lang={lang} />
  : <PlaceholderPage lang={lang} routeKey={routeKey} />}
