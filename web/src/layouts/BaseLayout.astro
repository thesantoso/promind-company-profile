---
import '../styles/global.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import dmSansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { htmlLang, type Locale } from '../i18n/locales';
import type { RouteKey } from '../i18n/routes';
import { loadSettings } from '../content/schema';
import { pathFor } from '../i18n/routes';
import { breadcrumbLd, organizationLd, serializeLd } from '../lib/jsonld';
import { getOgImage } from '../lib/og';
import { t, type UiKey } from '../i18n/ui';

interface Props {
  lang: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  paths?: Record<Locale, string>;
  /** Extra JSON-LD objects for this page (the organization and breadcrumbs are added here). */
  jsonLd?: object[];
  /** Breadcrumb entries after the route's own (e.g. the job title). */
  crumbs?: { name: string; path: string }[];
}
const { lang, routeKey, title, description, paths, jsonLd = [], crumbs = [] } = Astro.props;
const siteUrl = Astro.site!.href;
const graph: object[] = [organizationLd(lang, loadSettings(), siteUrl)];
if (routeKey !== 'home') {
  graph.push(
    breadcrumbLd(
      [
        { name: t(lang, 'nav.home'), path: pathFor('home', lang) },
        { name: t(lang, `nav.${routeKey}` as UiKey), path: pathFor(routeKey, lang) },
        ...crumbs,
      ],
      siteUrl,
    ),
  );
}
graph.push(...jsonLd);
const ogImage = await getOgImage(Astro.site!);
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansFont} as="font" type="font/woff2" crossorigin />
    <script is:inline type="application/ld+json" set:html={serializeLd(graph)} />
    <SeoHead lang={lang} routeKey={routeKey} title={title} description={description} ogImage={ogImage} paths={paths} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-surface focus:p-3">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} routeKey={routeKey} paths={paths} />
    <main id="main" class="mx-auto w-full max-w-[1200px] px-4 sm:px-6">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
