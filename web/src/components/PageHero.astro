---
// The live "Clean Editorial Header" shared by every sub-page (ServicesPage.jsx and friends).
interface Props { eyebrow: string; title: string; subtitle: string; subtitleClass?: string }
const { eyebrow, title, subtitle, subtitleClass = '' } = Astro.props;
---

<section class="bg-white border-b border-[#d8dfe5] py-20">
  <div class="wrap">
    <div class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="text-3xl sm:text-5xl font-bold text-[#172b42] font-manrope leading-tight mb-5">{title}</h1>
      <p class={`text-base sm:text-lg text-[#526374] leading-relaxed m-0 ${subtitleClass}`}>{subtitle}</p>
    </div>
  </div>
</section>
