---
interface Props { items: string[]; class?: string }
const { items, class: className } = Astro.props;
---

<ul class:list={['m-0 list-none space-y-2 p-0', className]}>
  {items.map((item) => (
    <li class="flex gap-3"><span aria-hidden="true" class="text-accent">•</span><span>{item}</span></li>
  ))}
</ul>
