---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/locales';
import type { RouteKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';

interface Props { lang: Locale; routeKey: RouteKey }
const { lang, routeKey } = Astro.props;
const heading = routeKey === 'home' ? t(lang, 'home.title') : t(lang, `nav.${routeKey}` as UiKey);
const title = routeKey === 'home' ? `PROMIND | ${heading}` : `${heading} | PROMIND`;
---

<BaseLayout lang={lang} routeKey={routeKey} title={title} description={t(lang, 'site.description')}>
  <h1 class="m-0 text-4xl font-extrabold">{heading}</h1>
  <p class="mt-4 max-w-prose">{t(lang, 'placeholder.soon')}</p>
</BaseLayout>
