---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

// Same fields and markup as the live ContactPage.jsx `.inquiry-form`. The worker's contract is
// unchanged: company and property type are sent at the top of `message`.
interface Labels { name: string; company: string; email: string; phone: string; propertyType: string; topic: string; message: string; submit: string }
interface Props { lang: Locale; topics: string[]; propertyTypes: string[]; labels: Labels; email: string; siteKey: string; endpoint?: string }
const { lang, topics, propertyTypes, labels, email, siteKey, endpoint = '/api/contact' } = Astro.props;
---

<form
  id="contact-form"
  class="inquiry-form"
  novalidate
  data-endpoint={endpoint}
  data-sending={t(lang, 'form.sending')}
  data-submit={labels.submit}
  data-label-company={labels.company}
  data-label-property={labels.propertyType}
>
  <label>
    <span>{labels.name}</span>
    <input name="name" type="text" autocomplete="name" required maxlength="80" />
  </label>
  <label>
    <span>{labels.company}</span>
    <input name="company" type="text" autocomplete="organization" required maxlength="120" />
  </label>
  <label>
    <span>{labels.email}</span>
    <input name="email" type="email" autocomplete="email" required maxlength="254" />
  </label>
  <label>
    <span>{labels.phone}</span>
    <input name="phone" type="tel" autocomplete="tel" required maxlength="30" />
  </label>
  <label>
    <span>{labels.propertyType}</span>
    <select name="propertyType">
      {propertyTypes.map((p) => <option value={p}>{p}</option>)}
    </select>
  </label>
  <label>
    <span>{labels.topic}</span>
    <select name="topic">
      {topics.map((topic) => <option value={topic}>{topic}</option>)}
    </select>
  </label>
  <label class="form-wide">
    <span>{labels.message}</span>
    <textarea name="message" rows="4" maxlength="3500"></textarea>
  </label>

  <div class="hp" aria-hidden="true">
    <label for="cf-website">Website</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form-wide form-actions">
  <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang} data-theme="light" data-appearance="interaction-only"></div>

  <div class="form-status" role="alert" data-alert>
    <p hidden data-status="error-required">{t(lang, 'form.error.required')}</p>
    <p hidden data-status="error-verify">{t(lang, 'form.error.verify')}</p>
    <p hidden data-status="error-rate">{t(lang, 'form.error.rate')} <a href={`mailto:${email}`}>{email}</a></p>
    <p hidden data-status="error-unavailable">{t(lang, 'form.error.unavailable')} <a href={`mailto:${email}`}>{email}</a></p>
    <p hidden data-status="error-failed">{t(lang, 'form.error.failed')} <a href={`mailto:${email}`}>{email}</a></p>
  </div>
  <div class="form-status" role="status"><p hidden data-status="success" class="form-success">{t(lang, 'form.success')}</p></div>

  <button type="submit" class="button button-light form-submit">
    <span data-label>{labels.submit}</span>
    <Icon name="arrow-up-right" size={18} />
  </button>
  </div>
</form>
