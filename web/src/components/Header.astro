---
import { Image } from 'astro:assets';
import logo from '../assets/promind-header-brand.png';
import type { Locale } from '../i18n/locales';
import { ROUTES, pathFor, type RouteKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props { lang: Locale; routeKey: RouteKey }
const { lang, routeKey } = Astro.props;
const keys = Object.keys(ROUTES).filter((k) => k !== 'home') as RouteKey[];
const items = keys.map((key) => ({
  key,
  href: pathFor(key, lang),
  label: t(lang, `nav.${key}` as UiKey),
  current: key === routeKey,
}));
const link = 'block px-3 py-3 font-display text-sm font-semibold text-heading no-underline hover:text-accent-hover aria-[current=page]:text-accent aria-[current=page]:underline underline-offset-8';
---

<header class="site-header sticky top-0 z-40 border-b border-hairline bg-surface">
  <div class="mx-auto flex w-full max-w-[1200px] items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <a href={pathFor('home', lang)} aria-label="PROMIND" class="shrink-0">
      <Image src={logo} alt="PROMIND" width={176} height={42} format="webp" loading="eager" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="m-0 flex list-none items-center gap-1 p-0">
        {items.map((i) => (
          <li><a class={link} href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitch lang={lang} routeKey={routeKey} />
      <details class="mobile-menu relative lg:hidden">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center border border-hairline-strong px-3 font-display text-sm font-bold text-heading">
          {t(lang, 'nav.menu')}
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 top-full mt-2 w-64 border border-hairline bg-surface p-2">
          <ul class="m-0 list-none p-0">
            {items.map((i) => (
              <li><a class={link} href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
