---
import { Image } from 'astro:assets';
import logo from '../assets/promind-header-brand.png';
import { htmlLang, type Locale } from '../i18n/locales';
import { ROUTES, pathFor, type RouteKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';
import { loadSettings } from '../content/schema';
import Icon from './Icon.astro';

// Markup and classes follow the live Navbar.jsx (the mobile drawer is inside the header, so opening it pushes the page down) so the live stylesheet renders it identically.
// Live inline styles (forbidden by our CSP) are classes in site.css: header-solid, brand-box, brand-img.
interface Props { lang: Locale; routeKey: RouteKey; paths?: Record<Locale, string> }
const { lang, routeKey, paths } = Astro.props;
const other: Locale = lang === 'id' ? 'en' : 'id';
const otherHref = paths ? paths[other] : pathFor(routeKey, other);
const items = (Object.keys(ROUTES) as RouteKey[]).map((key) => ({
  key,
  href: pathFor(key, lang),
  label: t(lang, `nav.${key}` as UiKey),
  current: key === routeKey,
}));
const s = loadSettings();
const navLink = (current: boolean) =>
  `text-[13px] font-bold tracking-tight whitespace-nowrap transition cursor-pointer py-1 relative border-0 bg-transparent ${
    current
      ? 'text-[#2b5caf] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-[#2b5caf]'
      : 'text-[#27384a] hover:text-[#2b5caf]'
  }`;
---

<header class="site-header sticky top-0 z-40 border-b border-[#e0e1de] shadow-sm transition-all duration-200 header-solid">
  <div class="wrap flex items-center justify-between h-[84px] gap-6">
    <a href={pathFor('home', lang)} class="flex items-center shrink-0 cursor-pointer text-left border-0 bg-transparent p-0 brand-box" aria-label="PROMIND">
      <Image src={logo} alt="" width={640} format="webp" quality={78} loading="eager" class="block mix-blend-multiply shrink-0 brand-img" />
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center space-x-7">
      {items.map((i) => (
        <a class={navLink(i.current)} href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>

    <div class="hidden sm:flex items-center space-x-4 shrink-0">
      <span class="text-xs font-bold text-[#3c4d60] px-2 py-1 lang-toggle"><span lang={htmlLang(lang)}>{lang.toUpperCase()}</span> / <a href={otherHref} hreflang={htmlLang(other)}><span lang={htmlLang(other)}>{other.toUpperCase()}</span><span class="sr-only" lang={htmlLang(other)}>&nbsp;– {t(lang, 'lang.switch')}</span></a></span>
      <a href={pathFor('contact', lang)} class="header-contact cursor-pointer border-0">
        <span>{t(lang, 'nav.cta')}</span>
        <Icon name="arrow-up-right" class="w-4 h-4" />
      </a>
    </div>

    <div class="flex items-center space-x-2 lg:hidden">
      <a href={otherHref} hreflang={htmlLang(other)} class="text-xs font-bold text-[#3c4d60] px-2 py-1 lang-toggle-mobile"><span lang={htmlLang(other)}>{other.toUpperCase()}</span><span class="sr-only" lang={htmlLang(other)}>&nbsp;– {t(lang, 'lang.switch')}</span></a>
      <button type="button" class="p-2 text-[#18365f] mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-label-open={t(lang, 'nav.menu')} data-label-close={t(lang, 'nav.close')}>
        <Icon name="menu" class="w-6 h-6 icon-open" />
        <Icon name="x" class="w-6 h-6 icon-close" />
        <span class="sr-only">{t(lang, 'nav.menu')}</span>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" aria-label="Mobile" class="lg:hidden border-t border-[#e0e1de] px-6 py-5 space-y-3 shadow-xl mobile-drawer is-closed">
    <div class="text-[10px] uppercase font-bold text-[#2b5caf] tracking-wider mb-2">{s.legalName}</div>
    {items.map((i) => (
      <a
        href={i.href}
        aria-current={i.current ? 'page' : undefined}
        class={`block w-full text-left py-2.5 text-sm font-bold ${i.current ? 'text-[#2b5caf]' : 'text-[#233547]'}`}
      >{i.label}</a>
    ))}
    <div class="pt-2">
      <a href={pathFor('contact', lang)} class="block w-full text-center py-3 bg-[#2959ab] text-white font-bold text-xs uppercase tracking-wider">{t(lang, 'nav.cta')}</a>
    </div>
  </nav>
  <script is:inline src="/scripts/menu.js" defer></script>
</header>
