---
import { Image } from 'astro:assets';
import logo from '../assets/promind-header-brand.png';
import { loadStandards } from '../content/load';
import { loadSettings } from '../content/schema';
import type { Locale } from '../i18n/locales';
import { ROUTES, pathFor, type RouteKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';

// Markup and classes follow the live Footer.jsx.
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = loadSettings();
const keys = Object.keys(ROUTES) as RouteKey[];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="footer-logo">
          <Image src={logo} alt="PROMIND" width={1024} format="webp" quality={90} loading="lazy" />
        </div>
        <strong class="uppercase">{s.legalName}</strong>
        <p>{s.tagline}</p>
      </div>

      <div class="footer-column">
        <h2>{t(lang, 'footer.office')}</h2>
        <address class="whitespace-pre-line not-italic text-sm leading-relaxed text-[#526171]">{s.address[lang]}</address>
        <a href={`mailto:${s.email}`} class="footer-email mt-3">{s.email}</a>
      </div>

      <nav class="footer-column" aria-label="Footer">
        <h2>{t(lang, 'footer.navigation')}</h2>
        {keys.map((k) => (
          <a href={pathFor(k, lang)} class="footer-nav-link block text-left text-sm text-[#31475f] hover:text-[#285bb0] mb-3 cursor-pointer">{t(lang, `nav.${k}` as UiKey)}</a>
        ))}
      </nav>

      <div class="footer-column footer-standards">
        <h2>{t(lang, 'footer.standards')}</h2>
        <ul>
          {loadStandards().map((std) => (
            <li>
              <strong>{std.code}</strong>
              <span>{std.name[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="uppercase">&copy; {year} {s.legalName}</span>
      <a href="#top" class="text-xs font-bold text-[#31475f] hover:text-[#285bb0] cursor-pointer">{t(lang, 'footer.top')} ↑</a>
    </div>
  </div>
</footer>
