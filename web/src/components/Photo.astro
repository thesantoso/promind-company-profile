---
import { Image } from 'astro:assets';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });

interface Props {
  name: string;
  alt: string;
  sizes: string;
  priority?: boolean;
  widths?: number[];
  /** height / width of the crop made at build time; omit to keep the photo's own ratio. */
  ratio?: number;
  quality?: number;
  /** AVIF is smallest; WebP decodes faster, which matters for the above-the-fold image. */
  format?: 'avif' | 'webp';
  class?: string;
}
const { name, alt, sizes, priority = false, widths = [480, 720, 960, 1280], ratio, quality = 55, format = 'avif', class: className } = Astro.props;
const photo = photos[`../assets/photos/${name}`];
if (!photo) throw new Error(`Unknown photo: ${name}`);
const largest = Math.max(...widths);
const crop = ratio ? { width: largest, height: Math.round(largest * ratio), fit: 'cover' as const, position: 'center' as const } : {};
---

<Image
  src={photo.default}
  alt={alt}
  widths={widths}
  {...crop}
  sizes={sizes}
  format={format}
  quality={quality}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  class={className}
/>
