---
interface Props { eyebrow?: string; title: string; subtitle?: string; id?: string }
const { eyebrow, title, subtitle, id } = Astro.props;
---

<section id={id} class="border-t border-hairline py-16 first:border-t-0 lg:py-24">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <header>
      {eyebrow && <p class="m-0 font-display text-xs font-bold uppercase tracking-[0.14em] text-accent">{eyebrow}</p>}
      <h2 class="mt-3 text-3xl font-extrabold lg:text-4xl">{title}</h2>
      {subtitle && <p class="mt-4 max-w-prose text-lg">{subtitle}</p>}
    </header>
    <div><slot /></div>
  </div>
</section>
