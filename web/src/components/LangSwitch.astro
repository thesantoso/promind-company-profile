---
import { htmlLang, type Locale } from '../i18n/locales';
import { pathFor, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Locale; routeKey: RouteKey }
const { lang, routeKey } = Astro.props;
const other: Locale = lang === 'id' ? 'en' : 'id';
---

<a
  href={pathFor(routeKey, other)}
  hreflang={htmlLang(other)}
  lang={htmlLang(other)}
  aria-label={t(lang, 'lang.switch')}
  class="inline-flex min-h-11 min-w-11 items-center justify-center border border-hairline-strong px-3 font-display text-sm font-bold uppercase tracking-wide text-heading no-underline hover:border-accent hover:text-accent-hover"
>{other}</a>
