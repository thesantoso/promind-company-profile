---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowButton from '../ArrowButton.astro';
import PageHero from '../PageHero.astro';
import { loadPages, loadPillars, loadStandards } from '../../content/load';
import { loadSettings } from '../../content/schema';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';
import { ordinal } from '../../lib/ordinal';

// Markup and classes follow the live AboutPage.jsx.
interface Props { lang: Locale }
const { lang } = Astro.props;
const { about: page } = loadPages();
const settings = loadSettings();
---

<BaseLayout lang={lang} routeKey="about" title={page.seo.title[lang]} description={page.seo.description[lang]}>
  <div class="bg-[#f6f5f1]">
    <PageHero eyebrow={page.eyebrow[lang]} title={page.title[lang]} subtitle={settings.legalName} subtitleClass="uppercase" />

    <section class="about section-pad bg-white border-b border-[#d8dfe5]">
      <div class="wrap about-grid">
        <div>
          <p class="eyebrow">{page.profileEyebrow[lang]}</p>
          <h2>{page.profileTitle[lang]}</h2>
        </div>
        <div class="about-copy">
          {page.story[lang].map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="value-section">
      <div class="wrap">
        <div class="value-heading">
          <div>
            <p class="eyebrow">{page.pillarsEyebrow[lang]}</p>
            <h2>{page.pillarsTitle[lang]}</h2>
          </div>
          <p>{page.pillarsBody[lang]}</p>
        </div>
        <div class="value-list">
          {loadPillars().map((p, i) => (
            <article>
              <span>{ordinal(i)}</span>
              <h3>{p.title[lang]}</h3>
              <p>{p.summary[lang]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad bg-white" data-standards>
      <div class="wrap">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-5">
            <p class="eyebrow">{page.standardsEyebrow[lang]}</p>
            <h2 class="text-3xl font-bold text-[#172b42] font-manrope leading-tight mb-4">{page.standardsTitle[lang]}</h2>
            <p class="text-sm sm:text-base text-[#5b6874] leading-relaxed m-0">{page.standardsBody[lang]}</p>
          </div>
          <div class="lg:col-span-7 border-t border-[#cbd2d9]">
            {loadStandards().map((std, i) => (
              <div class="py-6 border-b border-[#cbd2d9] grid grid-cols-[42px_1fr] gap-4 items-baseline">
                <span class="text-xs font-extrabold text-[#2b5caf]">{ordinal(i)}</span>
                <div>
                  <h3 class="text-lg font-bold text-[#172b42] font-manrope mb-1">{std.code}</h3>
                  <p class="text-sm text-[#5b6874] m-0">{std.name[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-14">
          <ArrowButton href={pathFor('contact', lang)} label={page.ctaLabel[lang]} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
