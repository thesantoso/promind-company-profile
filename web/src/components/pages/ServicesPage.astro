---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowButton from '../ArrowButton.astro';
import PageHero from '../PageHero.astro';
import { loadEngagement, loadPages, loadServices } from '../../content/load';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';
import { serviceLd } from '../../lib/jsonld';
import { ordinal } from '../../lib/ordinal';

// Markup and classes follow the live ServicesPage.jsx.
interface Props { lang: Locale }
const { lang } = Astro.props;
const { services: page } = loadPages();
const services = loadServices();
---

<BaseLayout
  lang={lang}
  routeKey="services"
  title={page.seo.title[lang]}
  description={page.seo.description[lang]}
  jsonLd={services.map((s) => serviceLd(s, lang, Astro.site!.href))}
>
  <div class="bg-[#f6f5f1]">
    <PageHero eyebrow={page.eyebrow[lang]} title={page.title[lang]} subtitle={page.subtitle[lang]} />

    <section class="section-pad">
      <div class="wrap">
        <div class="border-t border-[#cbd2d9]">
          {services.map((s, i) => (
            <article id={s.slug} class="grid grid-cols-1 lg:grid-cols-12 gap-8 py-12 border-b border-[#cbd2d9] items-start">
              <div class="lg:col-span-1">
                <span class="text-sm font-extrabold text-[#2b5caf]">{ordinal(i)}</span>
              </div>
              <div class="lg:col-span-5 pr-4">
                <h2 class="text-2xl font-bold text-[#172b42] font-manrope mb-3">{s.title[lang]}</h2>
                <p class="text-sm sm:text-base text-[#5b6874] leading-relaxed m-0">{s.summary[lang]}</p>
              </div>
              <div class="lg:col-span-6 bg-white border border-[#d8dfe5] p-6 sm:p-8">
                <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#2b5caf] block mb-4">{page.scopeLabel[lang]}</span>
                <ol class="list-none m-0 p-0 space-y-3" data-list="deliverables">
                  {s.deliverables[lang].map((d, j) => (
                    <li class="grid grid-cols-[28px_1fr] items-baseline text-xs sm:text-sm text-[#2c4157] pb-3 border-b border-[#eef2f5] last:border-b-0 last:pb-0">
                      <span class="text-[11px] font-extrabold text-[#3d6cad]">{ordinal(j)}</span>
                      <span class="leading-relaxed">{d}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="engagement section-pad border-t border-[#d8dfe5]">
      <div class="wrap engagement-grid">
        <div class="engagement-lead">
          <p class="eyebrow">{page.engagementEyebrow[lang]}</p>
          <h2>{page.engagementTitle[lang]}</h2>
          <p>{page.engagementBody[lang]}</p>
        </div>
        <div class="engagement-list">
          {loadEngagement().map((e, i) => (
            <article>
              <span>{ordinal(i)}</span>
              <div>
                <h3>{e.title[lang]}</h3>
                <p>{e.summary[lang]}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="wrap mt-14">
        <ArrowButton href={pathFor('contact', lang)} label={page.ctaLabel[lang]} />
      </div>
    </section>
  </div>
</BaseLayout>
