---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../ContactForm.astro';
import PageHero from '../PageHero.astro';
import { loadPages } from '../../content/load';
import { loadSettings } from '../../content/schema';
import type { Locale } from '../../i18n/locales';

// Markup and classes follow the live ContactPage.jsx. The form renders only when the Turnstile
// site key is set at build time (PUBLIC_TURNSTILE_SITEKEY).
interface Props { lang: Locale }
const { lang } = Astro.props;
const { contact: page } = loadPages();
const s = loadSettings();
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined;
const labels = Object.fromEntries(Object.entries(page.form).map(([k, v]) => [k, v[lang]])) as Record<keyof typeof page.form, string>;
---

<BaseLayout lang={lang} routeKey="contact" title={page.seo.title[lang]} description={page.seo.description[lang]}>
  <div class="bg-[#f6f5f1]">
    <PageHero eyebrow={page.eyebrow[lang]} title={page.title[lang]} subtitle={page.subtitle[lang]} />

    <section class="contact section-pad">
      <div class="wrap contact-grid">
        <div class="contact-lead">
          <p class="eyebrow">{page.formEyebrow[lang]}</p>
          <h2>{page.formTitle[lang]}</h2>
          <p>{page.formBody[lang]}</p>
          <a href={`mailto:${s.email}`} data-cta>{s.email}</a>
        </div>
        <div>
          {siteKey && (
            <ContactForm
              lang={lang}
              topics={page.serviceAreas[lang]}
              propertyTypes={page.propertyTypes[lang]}
              labels={labels}
              email={s.email}
              siteKey={siteKey}
              endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT}
            />
          )}
        </div>
      </div>
    </section>
  </div>
  {siteKey && <script is:inline slot="scripts" src="/scripts/contact-form.js" defer></script>}
  {siteKey && <script is:inline slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
